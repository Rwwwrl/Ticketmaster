# Git - read-only.
prefix_rule(["git", "rev-parse"], decision="allow")
prefix_rule(["git", "status"], decision="allow")
prefix_rule(["git", "diff"], decision="allow")
prefix_rule(["git", "log"], decision="allow")
prefix_rule(["git", "show"], decision="allow")
prefix_rule(["git", "show-ref"], decision="allow")
prefix_rule(["git", "branch"], decision="allow")
prefix_rule(["git", "check-ignore"], decision="allow")
prefix_rule(["git", "ls-tree"], decision="allow")

# GitHub CLI - read-only PR and workflow inspection.
prefix_rule(["gh", "pr", "view"], decision="allow")
prefix_rule(["gh", "pr", "diff"], decision="allow")
prefix_rule(["gh", "pr", "list"], decision="allow")
prefix_rule(["gh", "api"], decision="allow")
prefix_rule(["gh", "issue", "view"], decision="allow")
prefix_rule(["gh", "search"], decision="allow")
prefix_rule(["gh", "run", "view"], decision="allow")

# Shell utilities.
prefix_rule(["ls"], decision="allow")
prefix_rule(["find"], decision="allow")
prefix_rule(["rg"], decision="allow")
prefix_rule(["cat"], decision="allow")
prefix_rule(["sed"], decision="allow")
prefix_rule(["head"], decision="allow")
prefix_rule(["tail"], decision="allow")
prefix_rule(["wc"], decision="allow")
prefix_rule(["date"], decision="allow")
prefix_rule(["pwd"], decision="allow")
prefix_rule(["printenv"], decision="allow")

# Project dev recipes.
prefix_rule(["just", "--dry-run"], decision="allow")
prefix_rule(["just", "--list"], decision="allow")
prefix_rule(["just", "up-infra"], decision="allow")

# Safe local dev and inspection commands.
prefix_rule(["poetry"], decision="allow")
prefix_rule(["docker", "ps"], decision="allow")
prefix_rule(["docker", "compose"], decision="allow")
prefix_rule(["docker", "manifest", "inspect"], decision="allow")
prefix_rule(["pip", "show"], decision="allow")
prefix_rule(["pip", "index"], decision="allow")
